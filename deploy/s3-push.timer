# options_trader_v4/deploy/s3-push.timer — v4.0
# 2026-08-12 — initial release. Every 5 minutes, plus a catch-up shortly after
# boot: a box that traded weeks ago and is only now waking must flush its
# stranded archive before it starts trading again. RandomizedDelaySec keeps 29
# boxes from hitting S3 on the same instant.
[Unit]
Description=Vertigo warehouse push timer (5 min + boot catch-up)

[Timer]
OnCalendar=*:0/5
OnBootSec=90s
RandomizedDelaySec=30
Persistent=false
Unit=s3-push.service

[Install]
WantedBy=timers.target
