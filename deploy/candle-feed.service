# deploy/candle-feed.service  v5.0
# v5.0  2026-10-25  OTV5 r12 — HEADER RESET AT THE LINEAGE SPLIT, MISSED BY r7 (OTV5 r12, HDR.1). Every entry below this line is the predecessor's history (cited by its own prefix); from here each change to this file counts v5.1, v5.2, ...
# THE single TastyTrade/DXFeed candle producer for this box (Yahoo-Finance
# purge, Mandate 2: one DXLink subscription per box; every consumer reads the
# SQLite store). setup_ec2.sh v4.0 generates this unit with the box's env
# inline — this file is the reference copy for manual installs.
[Unit]
Description=options_trader v4.0 — single TastyTrade candle feed (DXFeed producer)
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/options-trader
# Needs the same TT_* credentials as the bot (its own process = its own OAuth
# session; the DXFeed SUBSCRIPTION is what must remain singular on the box).
EnvironmentFile=/home/ubuntu/options-trader/.env
ExecStart=/home/ubuntu/options-trader/venv/bin/python -m data.candle_feed
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=candle-feed

[Install]
WantedBy=multi-user.target
